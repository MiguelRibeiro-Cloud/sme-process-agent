# Required for model calls and for explicitly building the local RAG index.
OPENAI_API_KEY=

# Optional runtime overrides.
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional evaluation-only override; blank uses OPENAI_MODEL.
OPENAI_EVAL_MODEL=

# Runtime artifact paths. Blank keeps local .rag/.evals defaults.
# Railway image defaults point to /app/deployment equivalents.
RAG_INDEX_PATH=
EVALUATION_REPORT_PATH=

# Anonymous in-memory sessions. Enable Secure only behind HTTPS.
SESSION_COOKIE_NAME=sme_process_session
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TTL_SECONDS=7200
SESSION_MAX_COUNT=100

# Public-demo paid-request throttles and per-session lifetime caps.
PUBLIC_DEMO_CHAT_LIMIT=20
PUBLIC_DEMO_CHAT_WINDOW_SECONDS=600
PUBLIC_DEMO_ANALYSIS_LIMIT=3
PUBLIC_DEMO_ANALYSIS_WINDOW_SECONDS=600
PUBLIC_DEMO_MAX_CHAT_TURNS_PER_SESSION=40
PUBLIC_DEMO_MAX_ANALYSIS_RUNS_PER_SESSION=5

# Optional process-lifetime emergency fuse; blank disables it.
PUBLIC_DEMO_MAX_MODEL_OPERATIONS=
